<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="308dp"
    android:layout_height="match_parent"
    android:maxWidth="308dp"
    android:padding="1dp"
    android:background="@color/cor_borda">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cor_painel_background">
        
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:background="@color/cor_borda">
            <TextView
                android:text="Cadastro de Treinos"
                android:layout_width="274dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                style="@style/gstyTextViewTitulo"/>
            <ImageButton
                android:id="@+id/treino_cadastro_ibnFechar"
                android:src="@drawable/ic_close_red"
                android:background="@color/cor_dodgers"
                android:layout_width="38dp"
                android:layout_height="38dp"/>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cor_painel_background"
            android:padding="10dp">
            
            <TextView
                android:id="@+id/treino_cadastro_tbw01"
                android:text="Data:"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentLeft="true"
                style="@style/gstyTextView"/>
            <TextView
                android:id="@+id/treino_cadastro_tbw02"
                android:text="Hora:"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_alignParentTop="true"
                android:layout_toRightOf="@+id/treino_cadastro_tbw01"
                style="@style/gstyTextView"/>

            <LinearLayout
                android:id="@+id/treino_cadastro_llData"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_below="@+id/treino_cadastro_tvw01"
                android:layout_alignParentLeft="true"
                android:padding="1dp"
                android:background="@color/cor_borda">
                <EditText
                    android:id="@+id/treino_cadastro_edtData"
                    android:textAlignment="center"
                    android:editable="false"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    style="@style/gstyEditText"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/treino_cadastro_llHora"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="18dp"
                android:layout_below="@+id/treino_cadastro_tvw02"
                android:layout_toRightOf="@+id/treino_cadastro_llData"
                android:padding="1dp"
                android:background="@color/cor_borda">
                <EditText
                    android:id="@+id/treino_cadastro_edtHora"
                    android:textAlignment="center"
                    android:editable="false"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    style="@style/gstyEditText"/>
            </LinearLayout>            
            
            <TextView
                android:id="@+id/treino_cadastro_tbw03"
                android:text="Distância (m.): "
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/treino_cadastro_llData"
                android:layout_alignParentLeft="true"
                style="@style/gstyTextView"/>
            <TextView
                android:id="@+id/treino_cadastro_tbw04"
                android:text="Tempo: "
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/treino_cadastro_llHora"
                android:layout_toRightOf="@+id/treino_cadastro_tbw03"
                style="@style/gstyTextView"/>
            <TextView
                android:id="@+id/treino_cadastro_tbw05"
                android:text="p/100 m."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/treino_cadastro_llHora"
                android:layout_toRightOf="@+id/treino_cadastro_tbw04"
                style="@style/gstyTextView"/>

            <LinearLayout
                android:id="@+id/treino_cadastro_llDistancia"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="71dp"
                android:layout_below="@+id/treino_cadastro_tvw03"
                android:layout_alignParentLeft="true"
                android:padding="1dp"
                android:background="@color/cor_borda">
                <Spinner
                    android:id="@+id/treino_cadastro_spnDistancia"
                    android:background="@color/white"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/treino_cadastro_llTempo"
                android:orientation="horizontal"
                android:layout_width="90dp"
                android:layout_height="27dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="71dp"
                android:layout_below="@+id/treino_cadastro_tvw04"
                android:layout_toRightOf="@+id/treino_cadastro_llDistancia"
                android:padding="1dp"
                android:background="@color/cor_borda">
                <Spinner
                    android:id="@+id/treino_cadastro_spnH"
                    android:background="@color/white"
                    android:layout_width="18dp"
                    android:layout_height="match_parent"
                    android:paddingLeft="8dp"/>
                <TextView
                    android:text=":"
                    android:textAlignment="center"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    style="@style/gstyTextViewNew"/>
                <Spinner
                    android:id="@+id/treino_cadastro_spnMM"
                    android:background="@color/white"
                    android:layout_width="27dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:text=":"
                    android:textAlignment="center"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    style="@style/gstyTextViewNew"/>
                <Spinner
                    android:id="@+id/treino_cadastro_spnSS"
                    android:background="@color/white"
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:paddingRight="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/treino_cadastro_llPor100m"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="71dp"
                android:layout_below="@+id/treino_cadastro_tvw05"
                android:layout_toRightOf="@+id/treino_cadastro_llTempo"
                android:padding="1dp"
                android:background="@color/cor_borda">
                <EditText
                    android:id="@+id/treino_cadastro_edtPor100m"
                    android:textAlignment="center"
                    android:editable="false"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    style="@style/gstyEditText"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/treino_cadastro_ibnGravar"
                android:src="@drawable/ic_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="71dp"
                android:layout_toRightOf="@+id/treino_cadastro_llPor100m"
                style="@style/gstyButtonImageLight"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>