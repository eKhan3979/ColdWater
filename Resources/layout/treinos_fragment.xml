<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/cor_main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/treinos_llAguarde"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="1dp">
        <LinearLayout
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:text="Aguarde: - Carregando treinos ..."
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/cor_texto"
                android:textAlignment="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/treinos_llTreinosMain"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    
        <LinearLayout
            android:id="@+id/treinos_llParametros"
            android:layout_below="@+id/treinos_llEspaco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/cor_borda"
            android:padding="1sp"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/treinos_rlParametros"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="10dp"
                android:background="@color/cor_painel_background">
                <TextView
                    android:id="@+id/treinos_tvw_01"
                    android:text="Período de"
                    android:layout_height="20dp"
                    android:layout_width="wrap_content"
                    android:layout_marginRight="4dp"
                    style="@style/gstyTextView"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:background="@color/cor_borda">
                    <EditText
                        android:id="@+id/treinos_edt_de"
                        android:editable="false"
                        android:layout_height="24dp"
                        android:layout_width="80dp"
                        android:textStyle="bold"
                        android:background="@color/white"
                        style="@style/gstyEditText"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/treinos_tvw_02"
                    android:text="até"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    style="@style/gstyTextView"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:background="@color/cor_borda">
                    <EditText
                        android:id="@+id/treinos_edt_ate"
                        android:editable="false"
                        android:layout_height="24dp"
                        android:layout_width="80dp"
                        android:textStyle="bold"
                        style="@style/gstyEditText"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/treinos_llPesquisar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:orientation="vertical"
                    android:background="@color/cor_borda">
                    <ImageButton
                        android:id="@+id/treinos_ibnPesquisar"
                        android:src="@drawable/ic_lupa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:baselineAlignBottom="true"
                        style="@style/gstyButtonImageLight"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/treinos_llCadastro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:orientation="vertical"
                    android:background="@color/cor_borda">
                    <ImageButton
                        android:id="@+id/treinos_ibnCadastro"
                        android:src="@drawable/ic_cadastro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:baselineAlignBottom="true"
                        style="@style/gstyButtonImageLight"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/treinos_llResumo"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentLeft="true"
            android:padding="1dp"
            android:background="@color/cor_borda">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:paddingLeft="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="10dp"
                android:background="@color/cor_painel_background">
                <TextView
                    android:id="@+id/treinos_tvw_10"
                    android:text="Treinos"
                    android:textAlignment="center"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentLeft="true"
                    style="@styles/gstyTextView"/>
                <LinearLayout
                    android:id="@+id/treinos_llNTreinos"
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="24dp"
                    android:layout_alignParentLeft="true"
                    android:layout_below="@+id/treinos_tvw_10"
                    android:layout_marginLeft="4dp"
                    android:padding="1dp"
                    android:gravity="center_vertical"
                    android:background="@color/cor_borda">
                    <TextView
                        android:id="@+id/treinos_tvwNTreinos"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="2dp"
                        style="@style/gstyTextViewDestaque"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/treinos_tvw_11"
                    android:text="Km"
                    android:textAlignment="center"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toRightOf="@+id/treinos_tvw_10"
                    android:layout_marginLeft="5dp"
                    style="@styles/gstyTextView"/>
                <LinearLayout
                    android:id="@+id/treinos_llKm"
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/treinos_tvw_11"
                    android:layout_toRightOf="@+id/treinos_llNTreinos"
                    android:layout_marginLeft="5dp"
                    android:padding="1dp"
                    android:gravity="center_vertical"
                    android:background="@color/cor_borda">
                    <TextView
                        android:id="@+id/treinos_tvwKm"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="2dp"
                        style="@style/gstyTextViewDestaque"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/treinos_tvw_12"
                    android:text="Tempo"
                    android:textAlignment="center"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toRightOf="@+id/treinos_tvw_11"
                    android:layout_marginLeft="5dp"
                    style="@styles/gstyTextView"/>
                <LinearLayout
                    android:id="@+id/treinos_llTempo"
                    android:orientation="vertical"
                    android:layout_width="60dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/treinos_tvw_12"
                    android:layout_toRightOf="@+id/treinos_llKm"
                    android:layout_marginLeft="5dp"
                    android:padding="1dp"
                    android:gravity="center_vertical"
                    android:background="@color/cor_borda">
                    <TextView
                        android:id="@+id/treinos_tvwTempo"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="2dp"
                        style="@style/gstyTextViewDestaque"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/treinos_tvw_14"
                    android:text="100 m."
                    android:textAlignment="center"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toRightOf="@+id/treinos_tvw_12"
                    android:layout_marginLeft="5dp"
                    style="@styles/gstyTextView"/>
                <LinearLayout
                    android:id="@+id/treinos_llMedia"
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/treinos_tvw_14"
                    android:layout_toRightOf="@+id/treinos_llTempo"
                    android:layout_marginLeft="5dp"
                    android:padding="1dp"
                    android:gravity="center_vertical"
                    android:background="@color/cor_borda">
                    <TextView
                        android:id="@+id/treinos_tvwMedia"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="2dp"
                        style="@style/gstyTextViewDestaque"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/treinos_tvw_15"
                    android:text="Dia"
                    android:textAlignment="center"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toRightOf="@+id/treinos_tvw_14"
                    android:layout_marginLeft="5dp"
                    style="@styles/gstyTextView"/>
                <LinearLayout
                    android:id="@+id/treinos_llPorDia"
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/treinos_tvw_15"
                    android:layout_toRightOf="@+id/treinos_llMedia"
                    android:layout_marginLeft="5dp"
                    android:padding="1dp"
                    android:gravity="center_vertical"
                    android:background="@color/cor_borda">
                    <TextView
                        android:id="@+id/treinos_tvwPorDia"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="2dp"
                        style="@style/gstyTextViewDestaque"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/treinos_tvw_16"
                    android:text="1.000 m"
                    android:textAlignment="center"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toRightOf="@+id/treinos_tvw_15"
                    android:layout_marginLeft="5dp"
                    style="@styles/gstyTextView"/>
                <LinearLayout
                    android:id="@+id/treinos_llPorMil"
                    android:orientation="vertical"
                    android:layout_width="55dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/treinos_tvw_16"
                    android:layout_toRightOf="@+id/treinos_llPorDia"
                    android:layout_marginLeft="5dp"
                    android:padding="1dp"
                    android:gravity="center_vertical"
                    android:background="@color/cor_borda">
                    <TextView
                        android:id="@+id/treinos_tvwMil"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="2dp"
                        style="@style/gstyTextViewDestaque"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/treinos_llLista"
            android:background="@color/cor_borda"
            android:padding="1dp"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="346dp"
                android:orientation="vertical"
                android:background="@color/white">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/treinos_rvwLista"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </androidx.recyclerview.widget.RecyclerView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>